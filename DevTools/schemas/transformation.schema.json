{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "transformation.schema.json",
  "title": "Liber Noctis transformation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "name",
    "summary",
    "trust",
    "sources",
    "last_updated",
    "to",
    "method"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "defs.schema.json#/$defs/ref"
    },
    "kind": {
      "const": "transformation"
    },
    "name": {
      "$ref": "defs.schema.json#/$defs/text"
    },
    "aka": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/text"
      },
      "minItems": 1
    },
    "summary": {
      "$ref": "defs.schema.json#/$defs/md"
    },
    "trust": {
      "$ref": "defs.schema.json#/$defs/trust"
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "defs.schema.json#/$defs/ref"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "src"
            ],
            "properties": {
              "src": {
                "$ref": "defs.schema.json#/$defs/ref"
              },
              "note": {
                "$ref": "defs.schema.json#/$defs/text"
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "last_updated": {
      "$ref": "defs.schema.json#/$defs/date"
    },
    "see_also": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/ref"
      },
      "minItems": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/text"
      },
      "minItems": 1
    },
    "tbc": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/text"
      },
      "minItems": 1
    },
    "disputed": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/md"
      },
      "minItems": 1
    },
    "notes": {
      "$ref": "defs.schema.json#/$defs/md"
    },
    "from": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/ref"
      },
      "minItems": 1
    },
    "from_any": {
      "const": true
    },
    "to": {
      "$ref": "defs.schema.json#/$defs/ref"
    },
    "method": {
      "$ref": "defs.schema.json#/$defs/text"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/md"
      },
      "minItems": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/md"
      },
      "minItems": 1
    },
    "chance": {
      "$ref": "defs.schema.json#/$defs/text"
    },
    "when": {
      "$ref": "defs.schema.json#/$defs/text"
    },
    "cooldown": {
      "$ref": "defs.schema.json#/$defs/text"
    },
    "via": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/ref"
      },
      "minItems": 1
    },
    "featured": {
      "const": true,
      "description": "The way in a race page shows first, when a race has several"
    }
  }
}
