{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spell.schema.json",
  "title": "Liber Noctis spell",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "name",
    "summary",
    "trust",
    "sources",
    "last_updated",
    "form"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "defs.schema.json#/$defs/ref"
    },
    "kind": {
      "const": "spell"
    },
    "name": {
      "$ref": "defs.schema.json#/$defs/text"
    },
    "aka": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/text"
      },
      "minItems": 1
    },
    "summary": {
      "$ref": "defs.schema.json#/$defs/md"
    },
    "trust": {
      "$ref": "defs.schema.json#/$defs/trust"
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "defs.schema.json#/$defs/ref"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "src"
            ],
            "properties": {
              "src": {
                "$ref": "defs.schema.json#/$defs/ref"
              },
              "note": {
                "$ref": "defs.schema.json#/$defs/text"
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "last_updated": {
      "$ref": "defs.schema.json#/$defs/date"
    },
    "see_also": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/ref"
      },
      "minItems": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/text"
      },
      "minItems": 1
    },
    "tbc": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/text"
      },
      "minItems": 1
    },
    "disputed": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/md"
      },
      "minItems": 1
    },
    "notes": {
      "$ref": "defs.schema.json#/$defs/md"
    },
    "form": {
      "enum": [
        "spoken",
        "ritual",
        "granted"
      ]
    },
    "incantation": {
      "$ref": "defs.schema.json#/$defs/text"
    },
    "caster": {
      "$ref": "defs.schema.json#/$defs/level"
    },
    "unlock": {
      "$ref": "defs.schema.json#/$defs/md"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/qty"
      },
      "minItems": 1
    },
    "setup": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/md"
      },
      "minItems": 1
    },
    "effect": {
      "$ref": "defs.schema.json#/$defs/md"
    },
    "duration": {
      "$ref": "defs.schema.json#/$defs/md"
    },
    "cooldown": {
      "$ref": "defs.schema.json#/$defs/text"
    },
    "targets": {
      "$ref": "defs.schema.json#/$defs/text"
    },
    "works_on": {
      "$ref": "defs.schema.json#/$defs/worksOn"
    },
    "activates": {
      "$ref": "defs.schema.json#/$defs/ref"
    }
  }
}
