{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "item.schema.json",
  "title": "Liber Noctis item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "name",
    "summary",
    "trust",
    "sources",
    "last_updated",
    "category"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "defs.schema.json#/$defs/ref"
    },
    "kind": {
      "const": "item"
    },
    "name": {
      "$ref": "defs.schema.json#/$defs/text"
    },
    "aka": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/text"
      },
      "minItems": 1
    },
    "summary": {
      "$ref": "defs.schema.json#/$defs/md"
    },
    "images": {
      "$ref": "defs.schema.json#/$defs/images"
    },
    "trust": {
      "$ref": "defs.schema.json#/$defs/trust"
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "defs.schema.json#/$defs/ref"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "src"
            ],
            "properties": {
              "src": {
                "$ref": "defs.schema.json#/$defs/ref"
              },
              "note": {
                "$ref": "defs.schema.json#/$defs/text"
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "last_updated": {
      "$ref": "defs.schema.json#/$defs/date"
    },
    "see_also": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/ref"
      },
      "minItems": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/text"
      },
      "minItems": 1
    },
    "tbc": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/text"
      },
      "minItems": 1
    },
    "disputed": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/md"
      },
      "minItems": 1
    },
    "notes": {
      "$ref": "defs.schema.json#/$defs/md"
    },
    "category": {
      "enum": [
        "ingredient",
        "ore",
        "weapon",
        "trinket",
        "tool",
        "consumable",
        "food",
        "furniture"
      ]
    },
    "rarity": {
      "enum": [
        "common",
        "uncommon",
        "rare",
        "epic",
        "legendary"
      ],
      "description": "Tay's difficulty grade. Only on things that are made or found."
    },
    "effect": {
      "$ref": "defs.schema.json#/$defs/md"
    },
    "use": {
      "$ref": "defs.schema.json#/$defs/md"
    },
    "restricted_to": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/ref"
      },
      "minItems": 1
    },
    "durability": {
      "$ref": "defs.schema.json#/$defs/text"
    },
    "droppable": {
      "type": "boolean"
    },
    "works_on": {
      "$ref": "defs.schema.json#/$defs/worksOn"
    },
    "obtain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method"
        ],
        "properties": {
          "method": {
            "enum": [
              "found",
              "mined",
              "dropped",
              "reward",
              "ability",
              "made",
              "gamepass"
            ]
          },
          "place": {
            "$ref": "defs.schema.json#/$defs/ref"
          },
          "npc": {
            "$ref": "defs.schema.json#/$defs/ref"
          },
          "race": {
            "$ref": "defs.schema.json#/$defs/ref"
          },
          "ability": {
            "$ref": "defs.schema.json#/$defs/text"
          },
          "gamepass": {
            "$ref": "defs.schema.json#/$defs/ref"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "defs.schema.json#/$defs/ref"
            },
            "minItems": 1
          },
          "text": {
            "$ref": "defs.schema.json#/$defs/md"
          }
        }
      },
      "minItems": 1,
      "description": "Only ways that are NOT buying or crafting. Those come from merchant and recipe entries."
    }
  }
}
